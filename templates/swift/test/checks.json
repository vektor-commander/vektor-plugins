{
  "settings": { "greeting": "Hi" },
  "steps": [
    { "name": "startup: answers and logs",
      "startup": true,
      "expect": [ { "kind": "response" },
                  { "kind": "notification", "method": "log", "match": { "params.message": "Hello Plugin started." } } ] },
    { "name": "Say Hello answers with the greeting from the settings",
      "send": { "method": "invoke", "params": { "command": "hello", "target": { "menu": "fileItem", "items": [ { "path": "/tmp/a", "name": "a", "isFolder": false } ] } } },
      "expect": [ { "kind": "response", "match": { "result.message": { "contains": "Hi!" } } } ] },
    { "name": "a changed setting is used at once",
      "send": { "method": "settingsChanged", "params": { "settings": { "greeting": "Hola" }, "workspace": null } },
      "expect": [] },
    { "name": "the new greeting is said",
      "send": { "method": "invoke", "params": { "command": "hello", "target": { "menu": "fileItem", "items": [] } } },
      "expect": [ { "kind": "response", "match": { "result.message": { "matches": "^Hola! You chose" } } } ] },
    { "name": "an unknown command is refused with a reason",
      "send": { "method": "invoke", "params": { "command": "nonsense", "target": {} } },
      "expect": [ { "kind": "failure", "match": { "error.message": { "contains": "no command" } } } ] },
    { "name": "the view is described when it opens",
      "send": { "method": "view/opened", "params": { "view": "hello" } },
      "expect": [ { "method": "view/update", "match": {
                    "params.view": "hello", "params.description.revision": 1,
                    "params.description.blocks.type": "vstack",
                    "params.description.blocks.children.0.type": "textField",
                    "params.description.blocks.children.1.id": "names",
                    "params.description.blocks.children.1.children": { "count": 0 } } } ] },
    { "name": "a name typed in the field is added as a patch",
      "send": { "method": "view/event", "params": { "view": "hello", "action": "add", "block": "name", "value": "Ada", "revision": 1 } },
      "expect": [ { "method": "view/patch", "match": {
                    "params.revision": 2, "params.ops": { "count": 1 }, "params.ops.0.op": "insert", "params.ops.0.parent": "names",
                    "params.ops.0.block.title": "Hola, Ada!" },
                    "capture": { "ada": "params.ops.0.block.id" } } ] },
    { "name": "a second name goes after the first",
      "send": { "method": "view/event", "params": { "view": "hello", "action": "add", "block": "name", "value": "Grace", "revision": 2 } },
      "expect": [ { "method": "view/patch", "match": { "params.ops.0.op": "insert", "params.ops.0.index": 1 } } ] },
    { "name": "removing a name removes its row",
      "send": { "method": "view/event", "params": { "view": "hello", "action": "remove", "block": "${ada}", "revision": 3 } },
      "expect": [ { "method": "view/patch", "match": { "params.ops.0.op": "remove", "params.ops.0.id": "name-1" } } ] },
    { "name": "ping is answered and changes nothing",
      "send": { "method": "ping" },
      "expect": [ { "kind": "response" }, { "method": "view/update", "absent": true }, { "method": "view/patch", "absent": true } ] },
    { "name": "shutdown: answers and exits",
      "send": { "method": "shutdown", "params": { "reason": "quit" } },
      "expect": [ { "kind": "response" } ],
      "expectExit": true }
  ]
}
